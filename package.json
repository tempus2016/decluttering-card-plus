{
  "name": "decluttering-card-plus",
  "version": "1.0.0",
  "description": "Decluttering Card Plus for Lovelace",
  "main": "dist/decluttering-card-plus.js",
  "scripts": {
    "build": "npm run lint && npm run rollup",
    "lint": "eslint .",
    "rollup": "rollup -c",
    "start": "rollup -c --watch",
    "test": "tsc src/deep-replace.ts src/templates.ts src/share.ts src/variables.ts src/suggest.ts src/layout.ts src/registry.ts --outDir .test-build --module commonjs --target es2017 --skipLibCheck && node test/deep-replace.test.js && node test/templates.test.js && node test/share.test.js && node test/variables.test.js && node test/suggest.test.js && node test/layout.test.js && node test/registry.test.js && node test/styles-order.test.js"
  },
  "overrides": {
    "braces": "^3.0.3",
    "brace-expansion": "^5.0.9",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempus2016/decluttering-card-plus.git"
  },
  "keywords": [
    "lovelace"
  ],
  "author": "RomRider",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tempus2016/decluttering-card-plus/issues"
  },
  "homepage": "https://github.com/tempus2016/decluttering-card-plus#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.6.2",
    "rollup": "^4.62.4",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "semantic-release": "^25.0.9",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "home-assistant-js-websocket": "^9.6.0",
    "lit": "^3.3.3"
  },
  "contributors": [
    "j9brown",
    "simbaja",
    "tempus2016"
  ]
}
