{
  "name": "decluttering-card-plus",
  "version": "2.3.2",
  "description": "Card templates for Home Assistant dashboards: reusable cards, badges, rows and views with variables",
  "main": "dist/decluttering-card-plus.js",
  "scripts": {
    "build": "npm run lint && npm run rollup && node scripts/check-bundle-size.js",
    "lint": "eslint .",
    "rollup": "node scripts/clean-dist.js && rollup -c",
    "start": "rollup -c --watch",
    "test": "tsc -p tsconfig.test.json && node --test \"test/*.test.js\"",
    "coverage": "tsc -p tsconfig.test.json && c8 node --test \"test/*.test.js\"",
    "test:dom": "node scripts/dom-test.js"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tempus2016/decluttering-card-plus.git"
  },
  "keywords": [
    "lovelace"
  ],
  "author": "RomRider",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tempus2016/decluttering-card-plus/issues"
  },
  "homepage": "https://github.com/tempus2016/decluttering-card-plus#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "axe-core": "^4.14.0",
    "c8": "^12.0.0",
    "chai": "^5.3.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "rollup": "^4.64.6",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "semantic-release": "^25.0.9",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "home-assistant-js-websocket": "^9.7.1",
    "js-yaml": "^5.4.3",
    "lit": "^3.3.3"
  },
  "contributors": [
    "j9brown",
    "simbaja",
    "tempus2016"
  ],
  "c8": {
    "reporter": [
      "text-summary",
      "lcov"
    ],
    "include": [
      ".test-build/**/*.js"
    ],
    "all": false,
    "check-coverage": true,
    "statements": 95,
    "branches": 80,
    "functions": 90,
    "lines": 95
  }
}
