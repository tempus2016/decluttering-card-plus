// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "Decluttering Card Plus Development",
  "image": "ghcr.io/ludeeus/devcontainer/generic:stable",
  "context": "..",
  "remoteUser": "vscode",
  "appPort": [
    "5000:5000",
    "9123:8123"
  ],
  // --ignore-scripts: container creation runs the whole dependency tree, and a compromised
  // package's install hook should not get to run automatically. ci over install so the
  // lockfile is authoritative. The one package with an install script (fsevents) is
  // darwin-only and not needed here.
  "postCreateCommand": "npm ci --ignore-scripts",
  // The host ~/.ssh directory is deliberately not mounted: bind-mounting private keys into a
  // container that then installs npm packages is how a bad postinstall walks off with them.
  // VS Code Dev Containers forwards the host ssh-agent into the container on its own, so
  // `git push` still works as long as the key is added to the agent (ssh-add) on the host.
  "extensions": [
    "github.vscode-pull-request-github",
    "eamodio.gitlens",
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "bierner.lit-html",
    "runem.lit-plugin",
    "auchenberg.vscode-browser-preview",
    "davidanson.vscode-markdownlint",
    "redhat.vscode-yaml",
    "msjsdiag.debugger-for-chrome",
  ],
  "settings": {
    "files.eol": "\n",
    "editor.tabSize": 2,
    "terminal.integrated.shell.linux": "/bin/bash",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "files.trimTrailingWhitespace": true
  }
}